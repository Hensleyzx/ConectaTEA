{
  "expo": {
    "name": "ConectaTEA",
    "slug": "conectatea",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "conectatea",
    "icon": "./assets/conectatea-mark.png",
    "splash": {
      "image": "./assets/conectatea-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFF"
    },
    "assetBundlePatterns": ["**/*"],
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.conectatea.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/conectatea-mark.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.conectatea.app",
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/conectatea-mark.png"
    }
  }
}
